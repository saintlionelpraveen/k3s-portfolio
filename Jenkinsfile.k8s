pipeline {
    agent any

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Docker Image Tag')
        string(name: 'TARGET_NAMESPACE', defaultValue: 'default', description: 'Target Kubernetes Namespace')
    }

    environment {
        DOCKER_IMAGE = "messitebi/php-app"
        TARGET_NAMESPACE_ENV = "${params.TARGET_NAMESPACE}"
        IMAGE_TAG_ENV = "${params.IMAGE_TAG}"
    }

    stages {
        stage('Deploy to K8s') {
            steps {
                script {
                    echo "Deploying to namespace: ${env.TARGET_NAMESPACE_ENV}"
                    
                    bat """
                        kubectl get namespace ${env.TARGET_NAMESPACE_ENV} >nul 2>&1 || kubectl create namespace ${env.TARGET_NAMESPACE_ENV}
                    """
                    
                    bat """
                        kubectl apply -f deployment.yaml -n ${env.TARGET_NAMESPACE_ENV}
                        kubectl apply -f service.yaml -n ${env.TARGET_NAMESPACE_ENV}
                        kubectl set image deployment/php-app php-app=${env.DOCKER_IMAGE}:${env.IMAGE_TAG_ENV} -n ${env.TARGET_NAMESPACE_ENV}
                        kubectl rollout status deployment/php-app -n ${env.TARGET_NAMESPACE_ENV}
                    """
                }
            }
        }
    }
}
